{
  "rewrites": [
    { "source": "/api/press-release", "destination": "/api/app" },
    { "source": "/api/cron/daily-tasks", "destination": "/api/app" }
  ],
  "functions": {
    "api/app.py": { "maxDuration": 60 },
    "api/home.py": { "maxDuration": 15 },
    "api/login.py": { "maxDuration": 10 },
    "api/callback.py": { "maxDuration": 15 },
    "api/logout.py": { "maxDuration": 10 }
  },
  "crons": [
    { "path": "/api/cron/daily-tasks", "schedule": "0 0 * * *" }
  ]
}
