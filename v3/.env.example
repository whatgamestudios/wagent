# --- LLM providers -----------------------------------------------------
# Up to five numbered (model, API key) slots, tried in order 1-5. The first
# slot with MODEL_NAME_N set is the primary model; any further configured
# slots are automatic LangChain fallbacks if a call to an earlier one fails.
# Leave a pair blank to use fewer than five. MODEL_NAME_N is a LangChain
# init_chat_model() string: "<provider>:<model>" is recommended (bare model
# ids also work for well-known families, but the prefix is unambiguous).
MODEL_NAME_1=anthropic:claude-sonnet-5
MODEL_API_KEY_1=

MODEL_NAME_2=openai:gpt-4o-mini
MODEL_API_KEY_2=

MODEL_NAME_3=google_genai:gemini-2.0-flash
MODEL_API_KEY_3=

MODEL_NAME_4=groq:llama-3.3-70b-versatile
MODEL_API_KEY_4=

# A local Ollama model needs no API key; it picks up OLLAMA_BASE_URL below
# instead. Rarely reachable from a Vercel deployment — mainly for local dev.
MODEL_NAME_5=ollama:llama3.1
MODEL_API_KEY_5=
OLLAMA_BASE_URL=http://localhost:11434

# --- Email (daily_tasks) ------------------------------------------------
# Get a key from https://resend.com
RESEND_API_KEY=
# Comma-separated list of recipient email addresses
EMAIL_RECIPIENTS=
# Must be a verified sender/domain in your Resend account; defaults to
# Resend's shared onboarding@resend.dev sender if unset.
EMAIL_FROM=Worcadian Agent <onboarding@resend.dev>

# --- Cron security -------------------------------------------------------
# When set, /api/cron/daily-tasks requires this as a Bearer token. Vercel
# automatically sends it as the Authorization header on Cron Job requests
# once this same value is set as a Vercel environment variable.
CRON_SECRET=

# --- Optional (word-card / AI-illustration scripts carried over from v2) -
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
