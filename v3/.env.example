# --- LLM providers -----------------------------------------------------
# Up to five numbered (model, API key) slots, tried in order 1-5. The first
# slot with MODEL_NAME_N set is the primary model; any further configured
# slots are automatic LangChain fallbacks if a call to an earlier one fails.
# Leave a pair blank to use fewer than five. MODEL_NAME_N is a LangChain
# init_chat_model() string: "<provider>:<model>" is recommended (bare model
# ids also work for well-known families, but the prefix is unambiguous).
MODEL_NAME_1=anthropic:claude-sonnet-5
MODEL_API_KEY_1=

MODEL_NAME_2=openai:gpt-4o-mini
MODEL_API_KEY_2=

MODEL_NAME_3=google_genai:gemini-2.0-flash
MODEL_API_KEY_3=

MODEL_NAME_4=groq:llama-3.3-70b-versatile
MODEL_API_KEY_4=

# A local Ollama model needs no API key; it picks up OLLAMA_BASE_URL below
# instead. Rarely reachable from a Vercel deployment — mainly for local dev.
MODEL_NAME_5=ollama:llama3.1
MODEL_API_KEY_5=
OLLAMA_BASE_URL=http://localhost:11434

# --- Email (daily_tasks) ------------------------------------------------
# Get a key from https://resend.com
RESEND_API_KEY=
# Comma-separated list of recipient email addresses
EMAIL_RECIPIENTS=
# Must be a verified sender/domain in your Resend account; defaults to
# Resend's shared onboarding@resend.dev sender if unset.
EMAIL_FROM=Worcadian Agent <onboarding@resend.dev>

# --- Dictionary lookups (seed word + notable words) ---------------------
# Merriam-Webster Collegiate Dictionary API: https://dictionaryapi.com/products/api-collegiate-dictionary
# Get a free key at https://dictionaryapi.com/register/index
MERRIAM_WEBSTER_API_KEY=

# --- OAuth login (Auth0) --------------------------------------------------
# Required to gate the dashboard and the "Execute Daily Tasks" button behind
# Auth0 sign-in ("/" itself is a public landing page needing no login). Create
# a "Regular Web Application" at https://manage.auth0.com/ (Applications ->
# Create Application), then in its Settings tab add
# "<PUBLIC_BASE_URL>/auth/callback" to Allowed Callback URLs and
# "<PUBLIC_BASE_URL>" (no path) to Allowed Logout URLs -- both must match
# PUBLIC_BASE_URL below exactly.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Your deployed site's base URL, no trailing slash, e.g.
# https://worcadian-agent.vercel.app -- used to build the exact
# redirect_uri/returnTo URLs Auth0 checks against the Allowed Callback/Logout
# URLs above.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated list of email addresses allowed to log in. Anyone else who
# successfully authenticates via Auth0 is still denied access.
ALLOWED_EMAILS=

# Random secret used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# --- Posting to X (the "Submit Tweet to x.com" button) -------------------
# OAuth 2.0 Authorization Code flow with PKCE -- see
# worcadian_agent/twitter.py's module docstring. In the X Developer Portal
# (console.x.com), create a Project + App with "Read and Write" permissions
# (User authentication settings -> App permissions), enable OAuth 2.0, and
# add "<PUBLIC_BASE_URL>/api/x/callback" as a Callback URI (must match
# PUBLIC_BASE_URL above exactly). Then from "Keys and tokens" copy the
# Client ID and Client Secret (an older/renamed portal may label these "API
# Key"/"API Key Secret" -- same credentials).
X_API_KEY=
X_API_SECRET=

# A Postgres connection string (Neon: https://neon.tech) shared by the X and
# Instagram integrations below: it persists X's refresh token (which ROTATES
# every time it's used, so it can't just live in a static env var -- see
# worcadian_agent/token_store.py) and Instagram's long-lived token, and also
# temporarily hosts word card images so Instagram's API can fetch a public
# URL for them (see worcadian_agent/image_store.py).
DATABASE_URL=

# One-time setup after deploying and setting the vars above: while logged
# into the dashboard, visit /api/x/authorize once to connect the posting
# account (approve access on X; the resulting tokens are stored
# automatically). Redo this only if access is ever revoked.

# --- Posting to Instagram (the "Submit Image to Instagram" button) -------
# "Instagram API with Instagram Login" -- see
# worcadian_agent/instagram.py's module docstring. In the Meta Developer
# Portal (developers.facebook.com), create an App, add the "Instagram"
# product configured for "Instagram API with Instagram Login" (no Facebook
# Page needed), and in its settings add
# "<PUBLIC_BASE_URL>/api/instagram/callback" as a valid OAuth redirect URI
# (must match PUBLIC_BASE_URL above exactly).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta's console also requires a "Webhooks" configuration (Callback URL +
# Verify Token) to save the product's setup at all, even though this app
# doesn't act on any webhook events -- only posts content. Set
# "<PUBLIC_BASE_URL>/api/instagram/webhook" as the Callback URL, and any
# secret string of your choosing here (it must match exactly what you type
# into the console's "Verify token" field):
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# One-time setup after deploying and setting the vars above: while logged
# into the dashboard, visit /api/instagram/authorize once to connect the
# posting account (there's also a "Connect Instagram account" link next to
# the Word Card section). Redo this only if access is ever revoked, or the
# token expires from ~60 days of disuse.

# --- Cron security -------------------------------------------------------
# When set, /api/cron/daily-tasks requires this as a Bearer token. Vercel
# automatically sends it as the Authorization header on Cron Job requests
# once this same value is set as a Vercel environment variable.
CRON_SECRET=

# --- Optional (word-card / AI-illustration scripts carried over from v2) -
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
