# Choose "ollama" (default, local/free) or "anthropic" (remote Claude)
WORCADIAN_LLM_PROVIDER=ollama
WORCADIAN_LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Only needed when WORCADIAN_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only needed for generative_image.py (AI-generated word illustrations).
# Get a free Google AI Studio API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
